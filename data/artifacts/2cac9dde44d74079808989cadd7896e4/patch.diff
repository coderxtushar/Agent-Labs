 def truncate(text: str, limit: int, suffix: str = DEFAULT_SUFFIX) -> str:
-    """Shorten ``text`` so it fits within ``limit`` characters.
-
-    When the text is longer than ``limit`` it is cut and ``suffix`` is appended
