-truncate-boundary":{"files":{"src/textkit/truncate.py":"\"\"\"Length-limited text truncation.\n\nDeliberately flawed variant used by the ``regression-introducing`` demo agent:\nit satisfies every hidden acceptance test for the truncate task but drops the\n\"text that already fits is returned unchanged\" behaviour, so the pre-existing\ntests in ``tests/test_truncate.py`` break.  The ``pass_to_pass`` grading layer\nis what catches this.\n\"\"\"\n\nfrom __future__ import annotations\n\nDEFAULT_SUFFIX = \"...\"\n\n\ndef truncate(text: str, limit: int, suffix: str = DEFAULT_SUFFIX) -> str:\n    if limit < 0:\n        raise ValueError(\"limit must not be negative\")\n    if limit <= len(suffix):\n        return suffix[:limit]\n\n    budget = limit - len(suffix)\n    head = text[:budget]\n    boundary = head.rfind(\" \")\n    if boundary > 0:\n        head = head[:boundary]\n    return head.rstrip() + suffix\n"}}}},"sampling":{},"is_simulated":true,"provenance":"simulated","include_hints":false,"capabilities":{"key":"scripted","display_name":"Scripted agent (simulated)","description":"Applies predefined file contents and commands per task. Exercises the full sandbox/patch/grading pipeline deterministically without a model.","is_simulated":true,"requires_network":false,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":false,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"tasks":{"type":"object","description":"task_id -> {files, commands}"},"on_unknown_task":{"type":"string","enum":["noop","error"],"default":"noop"}}},"readiness_at_launch":{"ready":true,"detail":"1 scripted task action(s) configured","missing":[]}},"execution":{"repetitions":1,"concurrency":1,"seed":null,"include_hints":false,"limits_override":{},"sandbox_provider":"docker","infra_retry_limit":2,"hard_ceilings":{"max_agent_timeout_s":3600,"max_memory_mb":4096,"max_cpus":4.0}},"platform":{"version":"0.1.0"}},"progress":