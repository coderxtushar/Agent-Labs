92.9,26330],[171.1,92.8,26503],[181.2,92.9,26371],[191.2,93.0,26602],[201.2,92.9,26797],[211.3,92.6,26542],[221.4,93.5,27130],[231.5,93.1,27111],[241.5,92.6,27162],[251.6,93.0,27283],[261.6,92.7,27393],[271.6,93.1,27316],[281.7,93.0,27403],[291.8,93.0,27634],[301.9,92.9,27303],[311.9,92.8,27655],[322.0,93.1,27713],[332.0,93.1,27626],[342.0,92.9,27908],[352.0,93.0,27861],[355.3,92.7,27637]]},"task_snapshot":{"schema_version":"1.0","task_id":"textkit-dedupe-iterables","version":"1.0","title":"Make dedupe_words pure and accept any iterable","description":"dedupe_words removes duplicates by deleting from the caller's list and needs len()/indexing; refactor it to be non-mutating and iterable-friendly without changing its results.","problem_statement":"`textkit.dedupe.dedupe_words` returns the right words, but it works by deleting items from the list it was given, so callers lose their data, and it only works on mutable sequences.\n\nReproduction:\n\n    >>> from textkit.dedupe import dedupe_words\n    >>> words = [\"a\", \"b\", \"a\"]\n    >>> dedupe_words(words)\n    ['a', 'b']\n    >>> words\n    ['a', 'b']          # the caller's list was modified\n    >>> dedupe_words(w for w in [\"a\", \"a\"])\n    TypeError: object of type 'generator' has no len()\n\nRefactor it so that:\n\n- It never modifies its argument and always returns a new `list`, never the object it was passed.\n- It accepts any iterable of strings: lists, tuples, generators and one-shot iterators, each consumed exactly once.\n- Its results are otherwise unchanged: duplicates are removed, the first occurrence of each word is kept in its original position, and with `case_sensitive=False` words are compared using `str.lower()` and the first spelling seen is the one returned.\n\nKeep the function name, the parameters and the keyword-only `case_sensitive` flag. `tests/test_dedupe.py` describes behaviour that must not change.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"refactor","difficulty":"medium","tags":["refactor","purity","iterables","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_dedupe_iterables.py::test_input_list_is_not_mutated","tests/test_acceptance_dedupe_iterables.py::test_returns_a_new_list","tests/test_acceptance_dedupe_iterables.py::test_accepts_a_tuple","tests/test_acceptance_dedupe_iterables.py::test_accepts_a_generator","tests/test_acceptance_dedupe_iterables.py::test_accepts_a_one_shot_iterator_case_insensitively"],"pass_to_pass":["tests/test_dedupe.py::test_removes_duplicates","tests/test_dedupe.py::test_keeps_first_occurrence_order","tests/test_dedupe.py::test_case_insensitive_keeps_first_spelling","tests/test_dedupe.py::test_case_sensitive_by_default","tests/test_dedupe.py::test_empty_input","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_dedupe_iterables.py":"\"\"\"Hidden acceptance tests for task ``textkit-dedupe-iterables``.\"\"\"\n\nfrom textkit.dedupe import dedupe_words\n\n\ndef test_input_list_is_not_mutated():\n    words = [\"a\", \"b\", \"a\", \"c\", \"b\"]\n    dedupe_words(words)\n    assert words == [\"a\", \"b\", \"a\", \"c\", \"b\"]\n\n\ndef test_returns_a_new_list():\n    words = [\"a\", \"b\"]\n    result = dedupe_words(words)\n    assert result == [\"a\", \"b\"]\n    assert result is not words\n\n\ndef test_accepts_a_tuple():\n    assert dedupe_words((\"x\", \"y\", \"x\")) == [\"x\", \"y\"]\n\n\ndef test_accepts_a_generator():\n    assert dedupe_words(word for word in [\"x\", \"y\", \"x\", \"z\"]) == [\"x\", \"y\", \"z\"]\n\n\ndef test_accepts_a_one_shot_iterator_case_insensitively():\n    result = dedupe_words(iter([\"Go\", \"GO\", \"go\", \"Rust\"]), case_sensitive=False)\n    assert result == [\"Go\", \"Rust\"]\n    assert type(result) is list"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_dedupe_iterables.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":900,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":60},"context_files":["src/textkit/dedupe.py","tests/test_dedupe.py"],"acceptance_criteria":["The argument is never mutated","A new list is always returned","Tuples, generators and one-shot iterators are accepted","Order and case-insensitive behaviour are unchanged","Existing tests in tests/test_dedupe.py continue to pass"],"hints":["Build the result in a fresh list while tracking the keys already seen."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://127.0.0.1:11434/v1","max_tokens":8192,"request_retries":2,"request_timeout_s":900},"sampling":{},"is_simulated":false,"provenance":"live_model","include_hints":false,"capabilities":{"key":"openai_tools","display_name":"OpenAI-compatible tool-calling agent","description":"Host-side agent loop; tools run inside the sandbox. Works with any endpoint exposing /chat/completions with tool calling.","is_simulated":false,"requires_network":true,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":true,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"model":{"type":"string","required":true},"base_url":{"ty