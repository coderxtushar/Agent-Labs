5,92.8,16915],[140.5,91.9,16952],[150.6,92.1,16768],[160.6,92.2,16904],[170.6,92.7,17023],[180.6,92.7,17020],[190.7,92.6,16980],[200.7,91.4,17125],[210.7,92.3,17070],[220.8,91.7,17155],[230.8,92.7,17212],[233.5,91.6,17218]]},"task_snapshot":{"schema_version":"1.0","task_id":"textkit-word-count-whitespace","version":"1.0","title":"word_count miscounts runs of whitespace and non-space separators","description":"word_count splits on a single ASCII space, so empty text, repeated spaces, tabs, newlines and Unicode spaces all produce wrong counts.","problem_statement":"`textkit.stats.word_count` miscounts words whenever the whitespace is anything other than single ASCII spaces.\n\nReproduction:\n\n    >>> from textkit.stats import word_count\n    >>> word_count(\"\")\n    1\n    >>> word_count(\"hello   world\")\n    4\n\nExpected: 0 and 2.\n\nRequired behaviour:\n\n- A word is a maximal run of non-whitespace characters.\n- Any character for which `str.isspace()` is true separates words: spaces, tabs, newlines, carriage returns, and Unicode spaces such as U+00A0 NO-BREAK SPACE or U+3000 IDEOGRAPHIC SPACE.\n- A run of whitespace counts as one separator, and leading or trailing whitespace adds no words.\n- Empty or whitespace-only text has 0 words.\n\nPunctuation stays part of the word it touches (`\"hello, world!\"` is 2 words). Keep the signature; `tests/test_stats.py` must keep passing.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"bug_fix","difficulty":"easy","tags":["string-handling","bug-fix","unicode","whitespace","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_word_count_whitespace.py::test_empty_text_has_no_words","tests/test_acceptance_word_count_whitespace.py::test_whitespace_only_has_no_words","tests/test_acceptance_word_count_whitespace.py::test_repeated_spaces_count_once","tests/test_acceptance_word_count_whitespace.py::test_leading_and_trailing_whitespace_is_ignored","tests/test_acceptance_word_count_whitespace.py::test_tabs_and_newlines_separate_words","tests/test_acceptance_word_count_whitespace.py::test_unicode_spaces_separate_words"],"pass_to_pass":["tests/test_stats.py::test_two_words","tests/test_stats.py::test_single_word","tests/test_stats.py::test_sentence","tests/test_stats.py::test_punctuation_belongs_to_the_word","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_word_count_whitespace.py":"\"\"\"Hidden acceptance tests for task ``textkit-word-count-whitespace``.\"\"\"\n\nfrom textkit.stats import word_count\n\n\ndef test_empty_text_has_no_words():\n    assert word_count(\"\") == 0\n\n\ndef test_whitespace_only_has_no_words():\n    assert word_count(\"   \\t\\n \") == 0\n\n\ndef test_repeated_spaces_count_once():\n    assert word_count(\"hello    world\") == 2\n\n\ndef test_leading_and_trailing_whitespace_is_ignored():\n    assert word_count(\"  padded text  \") == 2\n\n\ndef test_tabs_and_newlines_separate_words():\n    assert word_count(\"one\\ttwo\\nthree\\r\\nfour\") == 4\n\n\ndef test_unicode_spaces_separate_words():\n    assert word_count(\"no\\u00a0break\\u2003em\\u3000ideographic\") == 4"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_word_count_whitespace.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":600,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":40},"context_files":["src/textkit/stats.py","tests/test_stats.py"],"acceptance_criteria":["Empty and whitespace-only text coun