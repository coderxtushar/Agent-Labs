 is included inside the budget, and the cut is made at a word boundary if one exists within that budget. `truncate(\"hello wonderful world\", 12)` must return `'hello...'`.\n- There is no trailing whitespace before the suffix.\n- When `limit` is less than or equal to the suffix length, return the suffix truncated to `limit` (so `limit=0` yields an empty string).\n- A negative `limit` still raises ValueError.\n\nThe existing tests in `tests/test_truncate.py` describe behaviour that must not change.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"regression_fix","difficulty":"medium","tags":["bug-fix","boundary-conditions","regression","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_truncate_boundary.py::test_result_never_exceeds_limit","tests/test_acceptance_truncate_boundary.py::test_cuts_at_word_boundary_when_possible","tests/test_acceptance_truncate_boundary.py::test_suffix_only_when_no_room_for_a_word","tests/test_acceptance_truncate_boundary.py::test_limit_smaller_than_suffix_truncates_the_suffix","tests/test_acceptance_truncate_boundary.py::test_zero_limit_returns_empty_string","tests/test_acceptance_truncate_boundary.py::test_custom_suffix_is_respected"],"pass_to_pass":["tests/test_truncate.py::test_short_text_is_returned_unchanged","tests/test_truncate.py::test_exact_length_is_returned_unchanged","tests/test_truncate.py::test_empty_text","tests/test_truncate.py::test_negative_limit_rejected"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_truncate_boundary.py":"\"\"\"Hidden acceptance tests for task ``textkit-truncate-boundary``.\"\"\"\n\nfrom textkit import truncate\n\n\ndef test_result_never_exceeds_limit():\n    assert len(truncate(\"abcdefghijklmnop\", 10)) <= 10\n\n\ndef test_cuts_at_word_boundary_when_possible():\n    assert truncate(\"hello wonderful world\", 12) == \"hello...\"\n\n\ndef test_suffix_only_when_no_room_for_a_word():\n    assert truncate(\"abcdefghij\", 5) == \"ab...\"\n\n\ndef test_limit_smaller_than_suffix_truncates_the_suffix():\n    assert truncate(\"abcdefghij\", 2) == \"..\"\n\n\ndef test_zero_limit_returns_empty_string():\n    assert truncate(\"abcdefghij\", 0) == \"\"\n\n\ndef test_custom_suffix_is_respected():\n    assert truncate(\"hello wonderful world\", 10, suffix=\"~\") == \"hello~\"\n\n\ndef test_no_trailing_space_before_suffix():\n    assert not truncate(\"hello wonderful world\", 13).removesuffix(\"...\").endswith(\" \")"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_truncate_boundary.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":900,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":60},"context_files":["src/textkit/truncate.py","tests/test_truncate.py"],"acceptance_criteria":["len(result) <= limit for every input","Text that fits is returned unchanged","Cut happens at a word boundary when one exists in the budget","limit <= len(suffix) returns the suffix truncated to limit","Existing tests in tests/test_truncate.py continue to pass"],"hints":["Reserve len(suffix) characters from the limit before cutting.","str.rfind(' ') locates the last word boundary in the budget."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","confi