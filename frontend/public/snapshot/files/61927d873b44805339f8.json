1.5,13402],[170.5,92.0,13450],[180.6,92.3,13456],[190.6,92.5,13543],[200.6,92.4,13540],[210.6,91.4,13609],[220.7,92.6,13618],[230.7,92.6,13880],[240.7,92.6,14100],[250.8,92.5,14213],[260.8,92.0,14309],[270.8,91.4,14277],[280.8,91.8,14237],[290.9,92.6,14195],[300.9,92.5,14296],[310.9,92.5,14305],[320.9,92.1,14396],[331.0,91.1,14372],[341.0,91.0,14594],[351.0,92.4,14740],[361.1,92.5,14799],[371.1,92.2,14960],[381.1,91.2,14952],[391.1,91.7,14920],[394.3,91.7,14712]]},"task_snapshot":{"schema_version":"1.0","task_id":"textkit-wordwrap","version":"1.0","title":"Implement greedy word wrapping in wrap_text","description":"wrap_text is declared with a documented contract but raises NotImplementedError.","problem_statement":"`textkit.wrap_text(text, width)` is declared in `src/textkit/wrap.py` but raises NotImplementedError. Implement it according to its docstring.\n\nRequired behaviour:\n\n- Return a list of lines, each at most `width` characters long.\n- Split the input on runs of whitespace; a run of whitespace is a single word separator, so `wrap_text(\"a   b\", 10) == [\"a b\"]`.\n- Pack words greedily: fill the current line while the next word still fits, then start a new line.\n- A word longer than `width` cannot fit on any line, so hard-split it across consecutive lines.\n- Input that contains no words returns an empty list.\n- Raise ValueError when `width` is less than 1.\n- Lines must carry no leading or trailing whitespace, and word order must be preserved.\n\nExample: `wrap_text(\"the quick brown fox\", 10)` returns `[\"the quick\", \"brown fox\"]`.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"feature","difficulty":"medium","tags":["feature","algorithm","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_wordwrap.py::test_empty_text_returns_empty_list","tests/test_acceptance_wordwrap.py::test_whitespace_only_returns_empty_list","tests/test_acceptance_wordwrap.py::test_wraps_on_word_boundaries","tests/test_acceptance_wordwrap.py::test_single_short_word","tests/test_acceptance_wordwrap.py::test_word_longer_than_width_is_hard_split","tests/test_acceptance_wordwrap.py::test_collapses_whitespace_runs","tests/test_acceptance_wordwrap.py::test_width_must_be_positive","tests/test_acceptance_wordwrap.py::test_no_line_exceeds_width","tests/test_acceptance_wordwrap.py::test_round_trips_words_in_order"],"pass_to_pass":["tests/test_slug.py::test_lowercases_words","tests/test_truncate.py::test_short_text_is_returned_unchanged"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_wordwrap.py":"\"\"\"Hidden acceptance tests for task ``textkit-wordwrap``.\"\"\"\n\nimport pytest\n\nfrom textkit import wrap_text\n\n\ndef test_empty_text_returns_empty_list():\n    assert wrap_text(\"\", 10) == []\n\n\ndef test_whitespace_only_returns_empty_list():\n    assert wrap_text(\"   \\n\\t \", 10) == []\n\n\ndef test_wraps_on_word_boundaries():\n    assert wrap_text(\"the quick brown fox\", 10) == [\"the quick\", \"brown fox\"]\n\n\ndef test_single_short_word():\n    assert wrap_text(\"hello\", 10) == [\"hello\"]\n\n\ndef test_word_longer_than_width_is_hard_split():\n    assert wrap_text(\"abcdefghij\", 4) == [\"abcd\", \"efgh\", \"ij\"]\n\n\ndef test_collapses_whitespace_runs():\n    assert wrap_text(\"a   b\", 10) == [\"a b\"]\n\n\ndef test_width_must_be_positive():\n    with pytest.raises(ValueError):\n        wrap_text(\"hello\", 0)\n\n\ndef test_no_line_exceeds_width():\n    text = \"alpha beta gamma delta epsilon zeta eta theta iota kappa\"\n    lines = wrap_text(text, 12)\n    assert lines\n    assert all(len(line) <= 12 for line in lines)\n\n\ndef test_round_trips_words_in_order():\n    text = \"alpha beta gamma delta epsilon\"\n    assert \" \".join(wrap_text(text, 11)).split() == text.split()"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_wordwrap.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":900,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":60},"context_files":["src/textkit/wrap.py","src/textkit/__init__.py"],"acceptance_criteria":["No returned line exceeds width","Words are packed greedily and kept in order","Words longer than width are hard-split","Whitespace runs collapse to a single separator","ValueError is raised for width < 1","Empty or whitespace-only input returns an empty list"],"hints":["str.split() with no argument already collapses whitespace runs."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://127.0.0.1:11434/v1","max_tokens":8192,"request_retries":2,"request_timeout_s":900},"sampling":{},"is_simulated":false,"provenance":"live_model","include_hints":false,"capabilities":{"key":"openai_tools","display_name":"OpenAI-compatible tool-calling agent","description":"Host-side agent loop; tools run inside the sandbox. Works with any endpoint exposing /chat/completions with tool calling.","is_simulated":false,"requires_network":true,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":true,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"model":{"type":"string","required":true},"base_url":{"type"