[30.3,92.6,3755],[40.4,92.1,3840],[50.5,92.9,4068],[60.5,92.6,4035],[70.6,92.6,4027],[80.6,92.5,4196],[90.8,92.6,4175],[100.9,92.4,4172],[110.9,92.4,4070],[121.0,92.4,4052],[131.1,92.2,4221],[141.1,91.9,4159],[151.2,92.4,4099],[161.3,92.0,4211],[171.3,92.5,4217],[181.3,92.6,4177],[191.4,90.6,4251],[201.4,91.8,4372],[211.5,92.5,4413],[221.5,92.4,4474],[231.6,90.9,4450],[241.7,92.2,4375],[251.7,91.2,4347],[261.7,91.1,4343],[271.8,91.1,4252],[281.9,90.0,4173],[291.9,91.0,4179],[301.9,91.8,4242],[312.0,92.0,4178],[322.0,92.5,4208],[332.0,90.9,4688],[342.1,91.6,5379],[352.2,91.1,5395],[362.2,91.0,5565],[372.3,92.3,5484],[382.3,92.0,5380],[392.4,91.9,5504],[402.4,90.6,5641],[412.4,89.3,5831],[422.5,89.4,5900],[432.6,90.1,6036],[442.6,90.9,6048],[452.6,92.3,6090],[462.6,91.6,6209],[472.7,91.7,6138],[482.7,91.7,6242],[492.7,92.3,6106],[502.7,92.8,6047],[508.3,91.1,6000]]},"task_snapshot":{"schema_version":"1.0","task_id":"textkit-parse-pairs-errors","version":"1.0","title":"parse_pairs raises the wrong error and truncates values","description":"parse_pairs never raises its documented ParseError (it leaks IndexError or silently accepts an empty key) and drops everything after a second '=' in a value.","problem_statement":"`textkit.pairs.parse_pairs` documents that malformed input raises `textkit.pairs.ParseError`, but it never does, and it mangles values that contain `=`.\n\nReproduction:\n\n    >>> from textkit.pairs import parse_pairs\n    >>> parse_pairs(\"a=1;oops\")\n    IndexError: list index out of range\n    >>> parse_pairs(\"=1\")\n    {'': '1'}\n    >>> parse_pairs(\"expr=x=1\")\n    {'expr': 'x'}\n\nRequired behaviour:\n\n- A non-empty segment that contains no `=` raises `ParseError`.\n- A segment whose key is empty or whitespace-only (for example `\"=1\"` or `\"  = 2\"`) raises `ParseError`.\n- The `ParseError` message contains the offending segment text, with its surrounding whitespace stripped, so the user can find it.\n- Only the first `=` in a segment separates the key from the value; the value keeps every later `=` (`\"expr=x=1\"` gives `{\"expr\": \"x=1\"}`).\n\nMust not change: `ParseError` remains a subclass of `ValueError`; empty segments are skipped; keys and values are stripped; an empty value (`\"key=\"`) is allowed; the last value of a repeated key wins; the `sep` argument keeps working. See `tests/test_pairs.py`.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"bug_fix","difficulty":"easy","tags":["parsing","bug-fix","error-handling","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_parse_pairs_errors.py::test_segment_without_equals_raises_parse_error","tests/test_acceptance_parse_pairs_errors.py::test_missing_equals_is_still_a_value_error","tests/test_acceptance_parse_pairs_errors.py::test_empty_key_raises_parse_error","tests/test_acceptance_parse_pairs_errors.py::test_blank_key_raises_parse_error","tests/test_acceptance_parse_pairs_errors.py::test_error_message_names_the_offending_segment","tests/test_acceptance_parse_pairs_errors.py::test_value_may_contain_equals_signs"],"pass_to_pass":["tests/test_pairs.py::test_basic_pairs","tests/test_pairs.py::test_whitespace_is_stripped_and_empty_segments_ignored","tests/test_pairs.py::test_empty_input","tests/test_pairs.py::test_custom_separator","tests/test_pairs.py::test_empty_value_is_allowed","tests/test_pairs.py::test_last_value_wins","tests/test_pairs.py::test_parse_error_is_a_value_error","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_parse_pairs_errors.py":"\"\"\"Hidden acceptance tests for task ``textkit-parse-pairs-errors``.\"\"\"\n\nimport pytest\n\nfrom textkit.pairs import ParseError, parse_pairs\n\n\ndef test_segment_without_equals_raises_parse_error():\n    with pytest.raises(ParseError):\n        parse_pairs(\"a=1;oops;b=2\")\n\n\ndef test_missing_equals_is_still_a_value_error():\n    with pytest.raises(ValueError):\n        parse_pairs(\"novalue\")\n\n\ndef test_empty_key_raises_parse_error():\n    with pytest.raises(ParseError):\n        parse_pairs(\"=1\")\n\n\ndef test_blank_key_raises_parse_error():\n    with pytest.raises(ParseError):\n        parse_pairs(\"a=1;   = 2\")\n\n\ndef test_error_message_names_the_offending_segment():\n    with pytest.raises(ParseError, match=\"broken-segment\"):\n        parse_pairs(\"a=1; broken-segment ;b=2\")\n\n\ndef test_value_may_contain_equals_signs():\n    assert parse_pairs(\"url=https://x.test/?q=1&r=2\") == {\"url\": \"https://x.test/?q=1&r=2\"}"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_parse_pairs_errors.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":600,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":40},"context_files":["src/textkit/pairs.py","tests/test_pairs.py"],"acceptance_criteria":["Segments without '=' raise ParseError","Empty or blank keys raise ParseError","The error message names the offending segment","Values may contain '='","Existing tests in tests/test_pairs.py continue to pass"],"hints":["str.partition splits on the first occurrence only."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://