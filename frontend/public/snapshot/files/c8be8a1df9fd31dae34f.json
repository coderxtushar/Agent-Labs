Args:\n        text: Input text. Runs of whitespace separate words.\n        width: Maximum line length. Must be at least 1.\n\n    Returns:\n        The wrapped lines, without trailing whitespace. Empty input yields an\n        empty list.\n\n    Raises:\n        ValueError: If ``width`` is less than 1.\n    \"\"\"\n    if width < 1:\n        raise ValueError(\"width must be at least 1\")\n\n    lines: list[str] = []\n    current = \"\"\n    for raw_word in text.split():\n        word = raw_word\n        # A word that cannot fit on any line is hard-split across lines.\n        while len(word) > width:\n            if current:\n                lines.append(current)\n                current = \"\"\n            lines.append(word[:width])\n            word = word[width:]\n        if not word:\n            continue\n        if not current:\n            current = word\n        elif len(current) + 1 + len(word) <= width:\n            current = f\"{current} {word}\"\n        else:\n            lines.append(current)\n            current = word\n\n    if current:\n        lines.append(current)\n    return lines\n"}},"textkit-truncate-boundary":{"files":{"src/textkit/truncate.py":"\"\"\"Length-limited text truncation.\"\"\"\n\nfrom __future__ import annotations\n\nDEFAULT_SUFFIX = \"...\"\n\n\ndef truncate(text: str, limit: int, suffix: str = DEFAULT_SUFFIX) -> str:\n    \"\"\"Shorten ``text`` so it fits within ``limit`` characters.\n\n    The returned string never exceeds ``limit``. When the text must be cut, the\n    cut is made at a word boundary if one exists inside the available budget.\n\n    Args:\n        text: Input text.\n        limit: Maximum length of the returned string, including ``suffix``.\n        suffix: Marker appended when the text was shortened.\n\n    Returns:\n        The original text when it already fits, otherwise a shortened version\n        no longer than ``limit``.\n\n    Raises:\n        ValueError: If ``limit`` is negative.\n    \"\"\"\n    if limit < 0:\n        raise ValueError(\"limit must not be negative\")\n    if len(text) <= limit:\n        return text\n    if limit <= len(suffix):\n        return suffix[:limit]\n\n    budget = limit - len(suffix)\n    head = text[:budget]\n    boundary = head.rfind(\" \")\n    if boundary > 0:\n        head = head[:boundary]\n    return head.rstrip() + suffix\n"}}}},"sampling":{},"is_simulated":true,"provenance":"simulated","include_hints":false,"capabilities":{"key":"scripted","display_name":"Scripted agent (simulated)","description":"Applies predefined file contents and commands per task. Exercises the full sandbox/patch/grading pipeline deterministically without a model.","is_simulated":true,"requires_network":false,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":false,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"tasks":{"type":"object","description":"task_id -> {files, commands}"},"on_unknown_task":{"type":"string","enum":["noop","error"],"default":"noop"}}},"readiness_at_launch":{"ready":true,"detail":"3 scripted task action(s) configured","missing":[]}},"execution":{"repetitions":1,"concurrency":1,"seed":null,"include_hints":false,"limits_override":{},"sandbox_provider":"docker","infra_retry_limit":2,"hard_ceilings":{"max_agent_timeout_s":3600,"max_memory_mb":4096,"max_cpus":4.0}},"platform":{"version":"0.1.0"}},"progress":{"total":3,"pending":0,"active":0,"completed":3,"cancelled":0,"finished":3,"percent":100.0,"is_complete":true,"skipped_live_lease":0,"by_outcome":{"solved":3}}}],"total":12,"source":"GET /experiments, every page"}