-python:3.12"}]},"agent":{"agent_config_id":"0efe921f520343b6978cbf612e8a1fb9","name":"regression-introducing","version":"1.0","adapter":"scripted","provider":null,"model":null,"prompt_version":"1.0","tools_version":"1.0","config":{"on_unknown_task":"noop","tasks":{"textkit-truncate-boundary":{"files":{"src/textkit/truncate.py":"\"\"\"Length-limited text truncation.\n\nDeliberately flawed variant used by the ``regression-introducing`` demo agent:\nit satisfies every hidden acceptance test for the truncate task but drops the\n\"text that already fits is returned unchanged\" behaviour, so the pre-existing\ntests in ``tests/test_truncate.py`` break.  The ``pass_to_pass`` grading layer\nis what catches this.\n\"\"\"\n\nfrom __future__ import annotations\n\nDEFAULT_SUFFIX = \"...\"\n\n\ndef truncate(text: str, limit: int, suffix: str = DEFAULT_SUFFIX) -> str:\n    if limit < 0:\n        raise ValueError(\"limit must not be negative\")\n    if limit <= len(suffix):\n        return suffix[:limit]\n\n    budget = limit - len(suffix)\n    head = text[:budget]\n    boundary = head.rfind(\" \")\n    if boundary > 0:\n        head = head[:boundary]\n    return head.rstrip() + suffix\n"}}}},"sampling":{},"is_simulated":true,"provenance":"simulated","include_hints":false,"capabilities":{"key":"scripted","display_name":"Scripted agent (simulated)","description":"Applies predefined file contents and commands per task. Exercises the full sandbox/patch/grading pipeline deterministically without a model.","is_simulated":true,"requires_network":false,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":false,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"tasks":{"type":"object","description":"task_id -> {files, commands}"},"on_unknown_task":{"type":"string","enum":["noop","error"],"default":"noop"}}},"readiness_at_launch":{"ready":true,"detail":"1 scripted task action(s) configured","missing":[]}},"execution":{"repetitions":1,"concurrency":1,"seed":null,"include_hints":false,"limits_override":{},"sandbox_provider":"docker","infra_retry_limit":2,"hard_ceilings":{"max_agent_timeout_s":3600,"max_memory_mb":4096,"max_cpus":4.0}},"platform":{"version":"0.1.0"}},"progress":{"total":3,"pending":0,"active":0,"completed":3,"cancelled":0,"finished":3,"percent":100.0,"is_complete":true,"skipped_live_lease":0,"by_outcome":{"unsolved":3}}},{"id":"efc52d5f53fe484a91522fc281ddf06e","name":"partial-solution-run","description":"","state":"completed","benchmark_id":"textkit","benchmark_version":"1.0","agent":{"config_id":"fd87852795f94365aaf5d64477cc717b","label":"partial-solution@1.0","adapter":"scripted","model":null,"provider":null,"prompt_version":"1.0","tools_version":"1.0","is_simulated":true,"readiness_at_launch":{"ready":true,"detail":"1 scripted task action(s) configured","missing":[]}},"provenance":{"value":"simulated","label":"Simulated agent","caveat":"Produced by a deterministic, non-model agent. These numbers validate the evaluation pipeline and are not a model benchmark result.","is_model_result":false},"grading_version":"1.0","repetitions":1,"concurrency":1,"seed":null,"include_hints":false,"limits_override":{},"task_keys":["textkit-slugify-collapse@1.0","textkit-truncate-boundary@1.0","textkit-wordwrap@1.0"],"baseline_experiment_id":null,"cancel_requested":false,"created_at":"2026-10-29T14:13:03.380018","started_at":"2026-10-29T14:13:03.388446","finished_at":"2026-10-29T14:14:07.116023","config_snapshot":{"created_at":"2026-10-29T14:13:03.378434+00:00","benchmark":{"id":"textkit","version":"1.0","tasks":[{"key":"textkit-slugify-collapse@1.0","category":"bug_fix","difficulty":"easy","grading_version":"1.0","validation_status":"valid","image":"agentbench/benchmark-python:3.12"},{"key":"textkit-truncate-boundary@1.0","category":"regression_fix","difficulty":"medium","grading_version":"1.0","validation_status":"valid","image":"agentbench/benchmark-python:3.12"},{"k