local_path","path":"textkit","revision":"local","subdir":null},"category":"bug_fix","difficulty":"easy","tags":["string-handling","bug-fix","unicode","whitespace","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_word_count_whitespace.py::test_empty_text_has_no_words","tests/test_acceptance_word_count_whitespace.py::test_whitespace_only_has_no_words","tests/test_acceptance_word_count_whitespace.py::test_repeated_spaces_count_once","tests/test_acceptance_word_count_whitespace.py::test_leading_and_trailing_whitespace_is_ignored","tests/test_acceptance_word_count_whitespace.py::test_tabs_and_newlines_separate_words","tests/test_acceptance_word_count_whitespace.py::test_unicode_spaces_separate_words"],"pass_to_pass":["tests/test_stats.py::test_two_words","tests/test_stats.py::test_single_word","tests/test_stats.py::test_sentence","tests/test_stats.py::test_punctuation_belongs_to_the_word","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_word_count_whitespace.py":"\"\"\"Hidden acceptance tests for task ``textkit-word-count-whitespace``.\"\"\"\n\nfrom textkit.stats import word_count\n\n\ndef test_empty_text_has_no_words():\n    assert word_count(\"\") == 0\n\n\ndef test_whitespace_only_has_no_words():\n    assert word_count(\"   \\t\\n \") == 0\n\n\ndef test_repeated_spaces_count_once():\n    assert word_count(\"hello    world\") == 2\n\n\ndef test_leading_and_trailing_whitespace_is_ignored():\n    assert word_count(\"  padded text  \") == 2\n\n\ndef test_tabs_and_newlines_separate_words():\n    assert word_count(\"one\\ttwo\\nthree\\r\\nfour\") == 4\n\n\ndef test_unicode_spaces_separate_words():\n    assert word_count(\"no\\u00a0break\\u2003em\\u3000ideographic\") == 4"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_word_count_whitespace.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":600,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":40},"context_files":["src/textkit/stats.py","tests/test_stats.py"],"acceptance_criteria":["Empty and whitespace-only text count as 0 words","Runs of whitespace count as a single separator","Tabs, newlines and Unicode whitespace separate words","Existing tests in tests/test_stats.py continue to pass"],"hints":["str.split() with no arguments splits on any run of whitespace."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://127.0.0.1:11434/v1","max_tokens":8192,"request_retries":2,"request_timeout_s":900},"sampling":{},"is_simulated":false,"provenance":"live_model","include_hints":false,"capabilities":{"key":"openai_tools","display_name":"OpenAI-compatible tool-calling agent","description":"Host-side agent loop; tools run inside the sandbox. Works with any endpoint exposing /chat/completions with tool calling.","is_simulated":false,"requires_network":true,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":true,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"model":{"type":"string","required":true},"base_url":{"type":"string","description":"Defaults to the configured provider"},"max_tokens":"***REDACTED***