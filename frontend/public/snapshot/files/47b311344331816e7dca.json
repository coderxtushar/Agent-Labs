:{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_indent_skip_blank.py::test_skip_blank_leaves_empty_lines_alone","tests/test_acceptance_indent_skip_blank.py::test_skip_blank_leaves_whitespace_only_lines_alone","tests/test_acceptance_indent_skip_blank.py::test_skip_blank_preserves_crlf","tests/test_acceptance_indent_skip_blank.py::test_skip_blank_false_matches_default_behaviour","tests/test_acceptance_indent_skip_blank.py::test_skip_blank_on_text_without_blank_lines"],"pass_to_pass":["tests/test_indent.py::test_prefixes_every_line","tests/test_indent.py::test_trailing_newline_is_preserved","tests/test_indent.py::test_blank_lines_are_prefixed_by_default","tests/test_indent.py::test_crlf_is_preserved","tests/test_indent.py::test_empty_text","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_indent_skip_blank.py":"\"\"\"Hidden acceptance tests for task ``textkit-indent-skip-blank``.\"\"\"\n\nfrom textkit.indent import indent\n\n\ndef test_skip_blank_leaves_empty_lines_alone():\n    assert indent(\"a\\n\\nb\\n\", \"> \", skip_blank=True) == \"> a\\n\\n> b\\n\"\n\n\ndef test_skip_blank_leaves_whitespace_only_lines_alone():\n    assert indent(\"a\\n   \\n\\tb\", \"> \", skip_blank=True) == \"> a\\n   \\n> \\tb\"\n\n\ndef test_skip_blank_preserves_crlf():\n    assert indent(\"a\\r\\n\\r\\nb\", \"# \", skip_blank=True) == \"# a\\r\\n\\r\\n# b\"\n\n\ndef test_skip_blank_false_matches_default_behaviour():\n    assert indent(\"a\\n\\nb\", \"> \", skip_blank=False) == \"> a\\n> \\n> b\"\n\n\ndef test_skip_blank_on_text_without_blank_lines():\n    assert indent(\"x\\ny\", \"  \", skip_blank=True) == \"  x\\n  y\""},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_indent_skip_blank.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":600,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":40},"context_files":["src/textkit/indent.py","tests/test_indent.py"],"acceptance_criteria":["skip_blank is a keyword-only parameter defaulting to False","With skip_blank=True, empty and whitespace-only lines are left unchanged","Line endings are preserved exactly","Default behaviour is unchanged"],"hints":["A line from splitlines(keepends=True) still carries its line ending; ignore it when deciding whether the line is blank."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://127.0.0.1:11434/v1","max_tokens":8192,"request_retries":2,"request_timeout_s":900},"sampling":{},"is_simulated":false,"provenance":"live_model","include_hints":false,"capabilities":{"key":"openai_tools","display_name":"OpenAI-compatible tool-calling agent","description":"Host-side agent loop; tools run inside the sandbox. Works with any endpoint exposing /chat/completions with tool calling.","is_simulated":false,"requires_network":true,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":true,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"model":{"type":"string","required":true},"base_url":{"type":"string","description":"Defaults to the configured provider"},"max_tokens":"***REDACTED***","allow_run_command":{"type":"boolean","default":true},"request_retries":{"type":"integer","default":3},"request_timeout_s":{"type":"inte