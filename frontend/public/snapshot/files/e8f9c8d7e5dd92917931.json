al","subdir":null},"category":"bug_fix","difficulty":"easy","tags":["string-handling","bug-fix","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_slug_collapse.py::test_collapses_repeated_separators","tests/test_acceptance_slug_collapse.py::test_strips_leading_and_trailing_separators","tests/test_acceptance_slug_collapse.py::test_punctuation_runs_collapse","tests/test_acceptance_slug_collapse.py::test_only_punctuation_yields_empty_slug","tests/test_acceptance_slug_collapse.py::test_custom_separator_also_collapses"],"pass_to_pass":["tests/test_slug.py::test_lowercases_words","tests/test_slug.py::test_single_space_becomes_separator","tests/test_slug.py::test_custom_separator","tests/test_slug.py::test_digits_are_kept","tests/test_slug.py::test_rejects_multi_character_separator"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_slug_collapse.py":"\"\"\"Hidden acceptance tests for task ``textkit-slugify-collapse``.\n\nStored outside the benchmark repository so the agent never sees it: this\ndirectory is not copied into the sandbox during the agent phase. The grading\nengine injects the file into the workspace immediately before running tests.\n\"\"\"\n\nfrom textkit import slugify\n\n\ndef test_collapses_repeated_separators():\n    assert slugify(\"Hello,  World!\") == \"hello-world\"\n\n\ndef test_strips_leading_and_trailing_separators():\n    assert slugify(\"  Hello  \") == \"hello\"\n\n\ndef test_punctuation_runs_collapse():\n    assert slugify(\"a---b\") == \"a-b\"\n\n\ndef test_only_punctuation_yields_empty_slug():\n    assert slugify(\"!!!\") == \"\"\n\n\ndef test_custom_separator_also_collapses():\n    assert slugify(\"Hello,  World!\", sep=\"_\") == \"hello_world\""},"require_non_e