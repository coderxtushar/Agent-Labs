,16981],[173.4,93.0,17376],[183.4,93.0,17369],[193.4,93.0,17329],[203.5,92.9,17202],[213.6,93.1,17250],[223.6,92.7,17370],[233.6,92.9,17351],[243.7,92.9,17524],[253.7,92.9,17499],[263.7,93.0,17434],[273.8,92.8,17431],[283.8,92.5,17663],[293.8,92.8,17874],[303.9,92.7,17949],[313.9,92.8,17940],[324.0,92.4,17801],[334.0,92.9,17823],[344.1,92.4,17905],[354.2,92.8,18020],[364.2,92.7,18080],[374.3,92.4,18101],[382.2,92.5,17852]]},"task_snapshot":{"schema_version":"1.0","task_id":"textkit-indent-skip-blank","version":"1.0","title":"Add a skip_blank option to indent","description":"indent prefixes every line, including blank ones; add a keyword-only skip_blank flag that leaves empty and whitespace-only lines untouched.","problem_statement":"Add a `skip_blank` option to `textkit.indent.indent`.\n\nToday `indent(text, prefix)` prefixes every line, including blank ones:\n\n    >>> from textkit.indent import indent\n    >>> indent(\"a\\n\\nb\", \"> \")\n    '> a\\n> \\n> b'\n\nAdd a keyword-only parameter `skip_blank: bool = False`:\n\n- With `skip_blank=True`, a line that is empty or contains only whitespace is returned unchanged: no prefix, and its own whitespace is kept. All other lines are prefixed as before.\n- Line endings, including `\\r\\n`, are preserved exactly, and no newline is added or removed.\n- The default (`skip_blank=False`) behaves exactly as today, and existing calls of the form `indent(text, prefix)` keep working.\n\nExample: `indent(\"def f():\\n\\n    pass\\n\", \"    \", skip_blank=True)` returns `\"    def f():\\n\\n        pass\\n\"`.\n\n`tests/test_indent.py` must keep passing.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"feature","difficulty":"easy","tags":["feature","string-handling","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_indent_skip_blank.py::test_skip_blank_leaves_empty_lines_alone","tests/test_acceptance_indent_skip_blank.py::test_skip_blank_leaves_whitespace_only_lines_alone","tests/test_acceptance_indent_skip_blank.py::test_skip_blank_preserves_crlf","tests/test_acceptance_indent_skip_blank.py::test_skip_blank_false_matches_default_behaviour","tests/test_acceptance_indent_skip_blank.py::test_skip_blank_on_text_without_blank_lines"],"pass_to_pass":["tests/test_indent.py::test_prefixes_every_line","tests/test_indent.py::test_trailing_newline_is_preserved","tests/test_indent.py::test_blank_lines_are_prefixed_by_default","tests/test_indent.py::test_crlf_is_preserved","tests/test_indent.py::test_empty_text","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_indent_skip_blank.py":"\"\"\"Hidden acceptance tests for task ``textkit-indent-skip-blank``.\"\"\"\n\nfrom textkit.indent import indent\n\n\ndef test_skip_blank_leaves_empty_lines_alone():\n    assert indent(\"a\\n\\nb\\n\", \"> \", skip_blank=True) == \"> a\\n\\n> b\\n\"\n\n\ndef test_skip_blank_leaves_whitespace_only_lines_alone():\n    assert indent(\"a\\n   \\n\\tb\", \"> \", skip_blank=True) == \"> a\\n   \\n> \\tb\"\n\n\ndef test_skip_blank_preserves_crlf():\n    assert indent(\"a\\r\\n\\r\\nb\", \"# \", skip_blank=True) == \"# a\\r\\n\\r\\n# b\"\n\n\ndef test_skip_blank_false_matches_default_behaviour():\n    assert indent(\"a\\n\\nb\", \"> \", skip_blank=False) == \"> a\\n> \\n> b\"\n\n\ndef test_skip_blank_on_text_without_blank_lines():\n    assert indent(\"x\\ny\", \"  \", skip_blank=True) == \"  x\\n  y\""},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_indent_skip_blank.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":600,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":40},"context_files":["src/textkit/indent.py","tests/test_indent.py"],"acceptance_criteria":["skip_blank is a keyword-only parameter defaulting to False","With skip_blank=True, empty and whitespace-only lines are left unchanged","Line endings are preserved exactly","Default behaviour is unchanged"],"hints":["A line from splitlines(keepends=True) still carries its line ending; ignore it when deciding whether the line is blank."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://127.0.0.1:11434/v1","max_tokens":8192,"request_retries":2,"request_timeout_s":900},"sampling":{},"is_simulated":false,"provenance":"live_model","include_hints":false,"capabilities":{"key":"openai_tools","display_name":"OpenAI-compatible tool-calling agent","description":"Host-side agent loop; tools run inside the sandbox. Works with any endpoint exposing /chat/completions with tool calling.","is_simulated":false,"requires_network":true,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":true,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"model":{"type":"string","required":true},"base_url":{"type":"string","description":"Defaults to the configured provider"},"max_tokens":"***REDACTED***","allow_run_command":{"type":"boolean","default":true},"request_retries":{"type":"integer","default":3},"request_timeout_s":{"type":"integer","default":180,"description":"Per-request read timeout, 10-1800 s; always clamped to the run's rem