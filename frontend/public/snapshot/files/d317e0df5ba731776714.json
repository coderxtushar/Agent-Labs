other uppercase letter and is itself followed by a lowercase letter (in that case it is the first letter of the next word).\n- So `XMLHttpRequest` becomes `xml_http_request` and `userID` becomes `user_id`.\n- Spaces, hyphens and underscores still separate words. The result is lowercase, never contains two underscores in a row, and never starts or ends with an underscore.\n\nExisting behaviour covered by `tests/test_case.py` (camelCase, PascalCase, spaces and hyphens, input that is already snake_case) must not change. Keep the function signature.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"bug_fix","difficulty":"medium","tags":["string-handling","bug-fix","identifiers","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_snake_case_acronyms.py::test_leading_acronym","tests/test_acceptance_snake_case_acronyms.py::test_acronym_in_the_middle","tests/test_acceptance_snake_case_acronyms.py::test_trailing_acronym","tests/test_acceptance_snake_case_acronyms.py::test_all_caps_word","tests/test_acceptance_snake_case_acronyms.py::test_acronym_followed_by_capitalised_word","tests/test_acceptance_snake_case_acronyms.py::test_acronym_before_explicit_separator"],"pass_to_pass":["tests/test_case.py::test_camel_case","tests/test_case.py::test_pascal_case","tests/test_case.py::test_spaces_and_hyphens","tests/test_case.py::test_already_snake_case_is_unchanged","tests/test_case.py::test_digits_stay_attached","tests/test_case.py::test_uppercase_after_digit_starts_a_word","tests/test_case.py::test_no_leading_trailing_or_double_underscores","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_snake_case_acronyms.py":"\"\"\"Hidden acceptance tests for task ``textkit-snake-case-acronyms``.\"\"\"\n\nfrom textkit.case import snake_case\n\n\ndef test_leading_acronym():\n    assert snake_case(\"HTTPServer\") == \"http_server\"\n\n\ndef test_acronym_in_the_middle():\n    assert snake_case(\"getHTTPResponseCode\") == \"get_http_response_code\"\n\n\ndef test_trailing_acronym():\n    assert snake_case(\"userID\") == \"user_id\"\n\n\ndef test_all_caps_word():\n    assert snake_case(\"ID\") == \"id\"\n\n\ndef test_acronym_followed_by_capitalised_word():\n    assert snake_case(\"XMLHttpRequest\") == \"xml_http_request\"\n\n\ndef test_acronym_before_explicit_separator():\n    assert snake_case(\"HTTP_Server\") == \"http_server\""},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_snake_case_acronyms.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":900,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":60},"context_files":["src/textkit/case.py","tests/test_case.py"],"acceptance_criteria":["Acronyms stay together as one word (HTTPServer -> http_server)","An acronym followed by a capitalised word is split before that word's first letter","An uppercase letter after a digit starts a new word","No double, leading or trailing underscores","Existing tests in tests/test_case.py continue to pass"],"hints":["Look at the characters on both sides of an uppercase letter before deciding to insert an underscore."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-2