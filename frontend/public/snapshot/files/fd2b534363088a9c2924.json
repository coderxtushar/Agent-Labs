,[201.0,93.0,24924],[211.1,92.4,25028],[222.1,91.8,25000],[232.2,92.9,25207],[242.2,92.9,25392],[252.3,92.9,25230],[263.6,92.5,25227],[273.6,92.8,25131],[283.6,93.0,25376],[293.7,92.7,25403],[303.7,92.9,25537],[313.7,92.7,25438],[323.8,92.9,25365],[333.8,92.9,25380],[336.2,92.6,25234]]},"task_snapshot":{"schema_version":"1.0","task_id":"textkit-line-range-inclusive","version":"1.0","title":"line_range is off by one","description":"line_range treats its 1-based line numbers as 0-based slice bounds, so it skips the first requested line.","problem_statement":"`textkit.lines.line_range(text, first, last)` is documented as returning lines `first` through `last` inclusive, numbered from 1, but it is off by one:\n\n    >>> from textkit.lines import line_range\n    >>> line_range(\"alpha\\nbeta\\ngamma\", 1, 2)\n    ['beta']\n\nExpected: ['alpha', 'beta']\n\nRequired behaviour:\n\n- Lines are numbered from 1 and both `first` and `last` are inclusive, so `line_range(text, n, n)` returns exactly line `n`.\n- A `last` beyond the end of the text is clamped to the final line.\n- Returned lines do not include their line endings (`\\n` or `\\r\\n`).\n\nMust not change: `first < 1` and `last < first` raise `ValueError`, and empty text yields `[]` (see `tests/test_lines.py`).","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"bug_fix","difficulty":"easy","tags":["bug-fix","off-by-one","boundary-conditions","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_line_range_inclusive.py::test_middle_range_is_inclusive","tests/test_acceptance_line_range_inclusive.py::test_single_first_line","tests/test_acceptance_line_range_inclusive.py::test_whole_text","tests/test_acceptance_line_range_inclusive.py::test_last_is_clamped_to_the_end","tests/test_acceptance_line_range_inclusive.py::test_single_line_text","tests/test_acceptance_line_range_inclusive.py::test_crlf_line_endings_are_not_included"],"pass_to_pass":["tests/test_lines.py::test_first_must_be_positive","tests/test_lines.py::test_last_must_not_precede_first","tests/test_lines.py::test_empty_text_has_no_lines","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_line_range_inclusive.py":"\"\"\"Hidden acceptance tests for task ``textkit-line-range-inclusive``.\"\"\"\n\nfrom textkit.lines import line_range\n\nTEXT = \"alpha\\nbeta\\ngamma\\ndelta\"\n\n\ndef test_middle_range_is_inclusive():\n    assert line_range(TEXT, 2, 3) == [\"beta\", \"gamma\"]\n\n\ndef test_single_first_line():\n    assert line_range(TEXT, 1, 1) == [\"alpha\"]\n\n\ndef test_whole_text():\n    assert line_range(TEXT, 1, 4) == [\"alpha\", \"beta\", \"gamma\", \"delta\"]\n\n\ndef test_last_is_clamped_to_the_end():\n    assert line_range(TEXT, 3, 99) == [\"gamma\", \"delta\"]\n\n\ndef test_single_line_text():\n    assert line_range(\"only\", 1, 1) == [\"only\"]\n\n\ndef test_crlf_line_endings_are_not_included():\n    assert line_range(\"a\\r\\nb\\r\\nc\\r\\n\", 2, 3) == [\"b\", \"c\"]"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_line_range_inclusive.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":600,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":40},"context_files":["src/textkit/lines.py","tests/test_lines.py"],"acceptance_criteria":["first and last are 1-based and inclusive","last beyond the end is clamped","Line endings are not included","Existing tests in tests/test_lines.py continue to pass"],"hints":["Convert