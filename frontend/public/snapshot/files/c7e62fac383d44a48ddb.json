mples":65},"host_constrained":true,"reasons":["memory pressure was warning in 65 of 65 samples"],"note":"Host-wide readings (every process, not only this run). When host_constrained is true, this run's timings may be inflated by swapping.","series":[[0.0,92.6,27897],[10.1,92.5,18187],[20.1,92.8,18099],[30.1,92.7,18346],[40.2,92.9,18775],[50.2,92.9,18707],[60.3,93.1,18792],[70.3,92.9,18764],[80.3,93.1,18924],[90.3,92.9,18904],[100.4,92.9,18948],[110.4,92.9,18941],[120.4,92.9,18931],[130.5,92.9,19034],[143.6,92.9,19053],[153.6,92.9,19045],[163.6,92.9,19210],[173.7,92.8,19330],[185.3,93.0,19312],[195.3,92.8,19256],[205.3,92.5,19206],[215.4,92.2,19431],[225.4,93.3,19517],[235.4,92.5,19524],[245.5,92.9,19479],[255.5,92.9,19346],[265.6,92.9,19352],[275.6,92.8,19388],[285.7,92.1,19739],[295.7,92.7,19659],[305.7,92.9,19610],[318.6,93.0,19573],[328.6,92.9,19485],[338.7,92.9,19677],[348.7,92.5,19916],[358.8,92.4,19957],[368.9,93.0,19805],[378.9,92.9,19839],[389.0,93.0,19804],[399.0,92.9,19724],[409.1,92.9,20002],[419.2,92.9,19963],[429.2,92.9,20109],[439.3,92.9,20054],[449.3,92.9,20067],[459.4,92.8,20167],[469.4,92.9,20280],[479.4,92.9,20305],[489.5,92.9,20475],[499.5,92.9,20453],[509.5,92.9,20599],[519.6,92.8,20699],[529.6,93.0,20812],[539.6,92.8,20841],[549.7,92.9,20747],[559.7,93.0,20589],[569.8,92.9,20635],[579.8,92.7,20816],[589.8,92.8,20903],[599.9,93.1,21137],[609.9,92.8,21155],[619.9,93.0,21210],[630.0,92.9,21315],[640.0,92.9,21479],[642.7,92.6,21247]]},"task_snapshot":{"schema_version":"1.0","task_id":"textkit-display-width-unicode","version":"1.0","title":"display_width and pad ignore wide and zero-width characters","description":"display_width uses len(), and pad has its own copy of that bug plus wrong centring and silent acceptance of unknown alignments, so CJK, emoji and combining marks misalign.","problem_statement":"`textkit.width.display_width` and `textkit.width.pad` treat every character as one terminal column, so tables containing CJK text, emoji or combining accents are misaligned.\n\nReproduction:\n\n    >>> from textkit.width import display_width, pad\n    >>> display_width(\"日本\")\n    2               # it occupies 4 columns in a terminal\n    >>> pad(\"日本\", 6)\n    '日本    '       # 8 columns wide instead of 6\n\nRequired behaviour for `display_width(text)`: return the sum of per-character widths, where a character is\n\n- 0 columns wide if it is a combining mark (non-zero canonical combining class) or a format character (Unicode general category `Cf`, for example U+200B ZERO WIDTH SPACE or U+200D ZERO WIDTH JOINER);\n- otherwise 2 columns wide if its East Asian Width property is `W` (wide) or `F` (fullwidth), which covers CJK ideographs, fullwidth forms and most emoji;\n- otherwise 1 column wide, including halfwidth and ambiguous-width characters.\n\nRequired behaviour for `pad(text, width, align=\"left\")`:\n\n- Padding is based on display width, so the result occupies exactly `width` columns. Text that already occupies `width` columns or more is returned unchanged.\n- `align` is `\"left\"`, `\"right\"` or `\"center\"`. When centring needs an odd number of padding spaces, the extra space goes on the right.\n- Any other `align` value raises `ValueError` (today it silently left-aligns).\n\nASCII behaviour covered by `tests/test_width.py` must not change.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"bug_fix","difficulty":"hard","tags":["unicode","bug-fix","terminal","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_display_width_unicode.py::test_wide_characters_take_two_columns","tests/test_acceptance_display_width_unicode.py::test_fullwidth_and_halfwidth_forms","tests/test_acceptance_display_width_unicode.py::test_emoji_is_wide","tests/test_acceptance_display_width_unicode.py::test_combining_marks_take_no_columns","tests/test_acceptance_display_width_unicode.py::test_zero_width_format_characters_take_no_columns","tests/test_acceptance_display_width_unicode.py::test_pad_wide_text_left_and_right","tests/test_acceptance_display_width_unicode.py::test_pad_counts_combining_marks_as_zero","tests/test_acceptance_display_width_unicode.py::test_wide_text_already_at_width_is_unchanged","tests/test_acceptance_display_width_unicode.py::test_center_puts_the_extra_space_on_the_right","tests/test_acceptance_display_width_unicode.py::test_unknown_alignment_raises_value_error"],"pass_to_pass":["tests/test_width.py::test_ascii_width","tests/test_width.py::test_empty_width","tests/test_width.py::test_left_pad_is_default","tests/test_width.py::test_right_align","tests/test_width.py::test_center_even_gap","tests/test_width.py::test_text_wider_than_width_is_unchanged","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_display_width_unicode.py":"\"\"\"Hidden acceptance tests for task ``textkit-display-width-unicode``.\"\"\"\n\nimport pytest\n\nfrom textkit.width import display_width, pad\n\n\ndef test_wide_characters_take_two_columns():\n    assert display_width(\"日本\") == 4\n\n\ndef test_fullwidth_and_halfwidth_forms():\n    assert display_width(\"\\uff21\\uff71\") == 3\n\n\ndef test_emoji_is_wide():\n    assert display_width(\"ok😀\") == 4\n\n\ndef test_combining_marks_take_no_columns():\n    assert display_width(\"cafe\\u0301\") == 4\n\n\ndef test_zero_width_format_characters_take_no_columns():\n    assert display_width(\"a\\u200bb\\u200dc\\ufeff\") == 3\n\n\ndef test_pad_wide_text_left_and_right():\n    assert pad(\"日本\", 6) == \"日本  \"\n    assert pad(\"日本\", 6, \"right\") == \"  日本\"\n\n\ndef test_pad_counts_combining_marks_as_zero():\n    assert pad(\"cafe\\u0301\", 6) == \"cafe\\u0301  \"\n\n\ndef test_wide_text_already_at_width_is_unchanged():\n    assert pad(\"日本語\", 4) == \"日本語\"\n\n\ndef test_center_puts_the_extra_space_on_the_right():\n    assert pad(\"ab\", 5, \"center\") == \" ab  \"\n\n\ndef test_unknown_alignment_raises_value_error():\n    with pytest.raises(ValueError):\n        pad(\"ab\", 4, \"middle\")"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_display_width_unicode.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":900,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":60},"context_files":["src/textkit/width.py","tests/test_width.py"],"acceptance_criteria":["Wide and fullwidth characters count as 2 columns","Combining marks and Cf format characters count as 0 columns","pad pads to display width, not code-point length","Odd centring puts the extra space on the right","Unknown align values raise ValueError","Existing tests in tests/test_width.py continue to pass"],"hints":["unicodedata exposes the combining class, general category and East Asian Width of a character.","pad has its own copy of the width bug."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://127.0.0.1:11434/v1","max_tokens":8192,"request_retries":2,"request_timeout_s":900},"sampling":{},"is_simulated":false,"provenance":"live_model","include_hints":false,"capabilities":{"key":"openai_tools","display_name":"OpenAI-compatible tool-calling agent","description":"Host-side agent loop; tools run inside the sandbox. Works with