],[221.5,92.7,23052],[231.5,93.0,23151],[241.6,93.1,23154],[251.6,93.2,23120],[261.7,92.9,23151],[271.7,93.2,23144],[281.8,93.0,23115],[291.8,93.0,23170],[301.9,93.1,23374],[311.9,93.2,23496],[322.0,93.2,23516],[332.0,93.2,23475],[342.0,93.0,23501],[352.1,93.1,23471],[362.1,93.0,23461],[372.1,93.1,23491],[376.9,92.9,23283]]},"task_snapshot":{"schema_version":"1.0","task_id":"textkit-ordinal","version":"1.0","title":"Add ordinal() to textkit.numbers","description":"New function: format a non-negative int with its English ordinal suffix, including the 11th/12th/13th exceptions and strict type checking.","problem_statement":"Add a new function `ordinal(n)` to `src/textkit/numbers.py`, next to `format_count`. It returns a non-negative integer followed by its English ordinal suffix.\n\nRequired behaviour:\n\n- The suffix is `st` for numbers ending in 1, `nd` for numbers ending in 2, `rd` for numbers ending in 3, and `th` otherwise: `ordinal(1) == \"1st\"`, `ordinal(22) == \"22nd\"`, `ordinal(4) == \"4th\"`, `ordinal(0) == \"0th\"`.\n- Numbers whose last two digits are 11, 12 or 13 always take `th`: `ordinal(12) == \"12th\"`, `ordinal(111) == \"111th\"`.\n- A negative `n` raises `ValueError`.\n- Anything that is not an `int` (for example `2.0` or `\"3\"`) raises `TypeError`. `bool` is rejected with `TypeError` as well, even though it is a subclass of `int`.\n\nIt must be importable as `from textkit.numbers import ordinal`. Do not change `format_count`; `tests/test_numbers.py` must keep passing.","repo":{"kind":"local_path","path":"textkit","revision":"local","subdir":null},"category":"feature","difficulty":"easy","tags":["feature","formatting","python"],"environment":{"image":"agentbench/benchmark-python:3.12","setup_commands":["python -m pytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_ordinal.py::test_first_ten","tests/test_acceptance_ordinal.py::test_teens_always_take_th","tests/test_acceptance_ordinal.py::test_twenties","tests/test_acceptance_ordinal.py::test_hundreds","tests/test_acceptance_ordinal.py::test_negative_raises_value_error","tests/test_acceptance_ordinal.py::test_non_integers_raise_type_error","tests/test_acceptance_ordinal.py::test_bool_is_rejected"],"pass_to_pass":["tests/test_numbers.py::test_singular","tests/test_numbers.py::test_plural","tests/test_numbers.py::test_zero_is_plural","tests/test_numbers.py::test_irregular_plural","tests/test_slug.py::test_lowercases_words"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_ordinal.py":"\"\"\"Hidden acceptance tests for task ``textkit-ordinal``.\"\"\"\n\nimport pytest\n\nimport textkit.numbers as numbers\n\n\ndef test_first_ten():\n    expected = [\"0th\", \"1st\", \"2nd\", \"3rd\", \"4th\", \"5th\", \"6th\", \"7th\", \"8th\", \"9th\"]\n    assert [numbers.ordinal(n) for n in range(10)] == expected\n\n\ndef test_teens_always_take_th():\n    assert [numbers.ordinal(n) for n in (11, 12, 13)] == [\"11th\", \"12th\", \"13th\"]\n\n\ndef test_twenties():\n    assert [numbers.ordinal(n) for n in (21, 22, 23, 24)] == [\"21st\", \"22nd\", \"23rd\", \"24th\"]\n\n\ndef test_hundreds():\n    assert [numbers.ordinal(n) for n in (100, 101, 102, 111, 112, 113, 121)] == [\n        \"100th\",\n        \"101st\",\n        \"102nd\",\n        \"111th\",\n        \"112th\",\n        \"113th\",\n        \"121st\",\n    ]\n\n\ndef test_negative_raises_value_error():\n    with pytest.raises(ValueError):\n        numbers.ordinal(-1)\n\n\ndef test_non_integers_raise_type_error():\n    with pytest.raises(TypeError):\n        numbers.ordinal(2.0)\n    with pytest.raises(TypeError):\n        numbers.ordinal(\"3\")\n\n\ndef test_bool_is_rejected():\n    with pytest.raises(TypeError):\n        numbers.ordinal(True)"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_ordinal.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":600,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":40},"context_files":["src/textkit/numbers.py","tests/test_numbers.py"],"acceptance_criteria":["Correct st/nd/rd/th suffixes","11, 12 and 13 (and 111, 112, 113, ...) take 'th'","Negative input raises ValueError","Non-int input, including bool, raises TypeError","format_count is unchanged"],"hints":["Check n % 100 before n % 10."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://127.0.0.1:11434/v1","max_tokens":8192,"request_retries":2,"request_timeout_s":900},"sampling":{},"is_simulated":false,"provenance":"live_model","include_hints":false,"capabilities":{"key":"openai_tools","display_name":"OpenAI-compatible tool-calling agent","description":"Host-side agent loop; tools run inside the sandbox. Works with any endpoint exposing /chat/completions with tool calling.","is_simulated":false,"requires_network":true,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","reports_cost":true,"supports_cancellation":true,"streams_events":true,"contract_version":"1.0","config_schema":{"model":{"type":"string","required":true},"base_url":{"type":"string","description":"Defaults to the configured provider"},"max_tokens":"***REDACTED***","allow_run_command":{"type":"boolean","default":true},"request_retries":{"type":"integer","default":3},"request_timeout_s":{"type":"integer","default":180,"description":"Per-req