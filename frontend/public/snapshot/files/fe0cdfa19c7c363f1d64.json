ytest --version"],"env":{},"workdir":"/workspace/repo","pip_packages":[]},"tests":{"runner":"pytest","command":"python -m pytest -p no:cacheprovider -q --tb=short {selection}","fail_to_pass":["tests/test_acceptance_wordwrap.py::test_empty_text_returns_empty_list","tests/test_acceptance_wordwrap.py::test_whitespace_only_returns_empty_list","tests/test_acceptance_wordwrap.py::test_wraps_on_word_boundaries","tests/test_acceptance_wordwrap.py::test_single_short_word","tests/test_acceptance_wordwrap.py::test_word_longer_than_width_is_hard_split","tests/test_acceptance_wordwrap.py::test_collapses_whitespace_runs","tests/test_acceptance_wordwrap.py::test_width_must_be_positive","tests/test_acceptance_wordwrap.py::test_no_line_exceeds_width","tests/test_acceptance_wordwrap.py::test_round_trips_words_in_order"],"pass_to_pass":["tests/test_slug.py::test_lowercases_words","tests/test_truncate.py::test_short_text_is_returned_unchanged"]},"grading":{"version":"1.0","acceptance_tests":{"tests/test_acceptance_wordwrap.py":"\"\"\"Hidden acceptance tests for task ``textkit-wordwrap``.\"\"\"\n\nimport pytest\n\nfrom textkit import wrap_text\n\n\ndef test_empty_text_returns_empty_list():\n    assert wrap_text(\"\", 10) == []\n\n\ndef test_whitespace_only_returns_empty_list():\n    assert wrap_text(\"   \\n\\t \", 10) == []\n\n\ndef test_wraps_on_word_boundaries():\n    assert wrap_text(\"the quick brown fox\", 10) == [\"the quick\", \"brown fox\"]\n\n\ndef test_single_short_word():\n    assert wrap_text(\"hello\", 10) == [\"hello\"]\n\n\ndef test_word_longer_than_width_is_hard_split():\n    assert wrap_text(\"abcdefghij\", 4) == [\"abcd\", \"efgh\", \"ij\"]\n\n\ndef test_collapses_whitespace_runs():\n    assert wrap_text(\"a   b\", 10) == [\"a b\"]\n\n\ndef test_width_must_be_positive():\n    with pytest.raises(ValueError):\n        wrap_text(\"hello\", 0)\n\n\ndef test_no_line_exceeds_width():\n    text = \"alpha beta gamma delta epsilon zeta eta theta iota kappa\"\n    lines = wrap_text(text, 12)\n    assert lines\n    assert all(len(line) <= 12 for line in lines)\n\n\ndef test_round_trips_words_in_order():\n    text = \"alpha beta gamma delta epsilon\"\n    assert \" \".join(wrap_text(text, 11)).split() == text.split()"},"require_non_empty_patch":true,"forbidden_paths":["**/conftest.py","pyproject.toml","pytest.ini","setup.cfg","tests/**","tests/test_acceptance_wordwrap.py","tox.ini"],"verify_baseline":true,"static_checks":[],"judge":{"enabled":false,"rubric":"","model":null}},"limits":{"agent_timeout_s":900,"setup_timeout_s":180,"test_timeout_s":180,"memory_mb":1024,"cpus":1.0,"disk_mb":4096,"network":"none","max_agent_steps":60},"context_files":["src/textkit/wrap.py","src/textkit/__init__.py"],"acceptance_criteria":["No returned line exceeds width","Words are packed greedily and kept in order","Words longer than width are hard-split","Whitespace runs collapse to a single separator","ValueError is raised for width < 1","Empty or whitespace-only input returns an empty list"],"hints":["str.split() with no argument already collapses whitespace runs."],"metadata":{"author":"agentbench-lab","license":"MIT","repo_origin":"self-authored sample repository"}},"agent_snapshot":{"agent_config_id":"8b62ccd3c141485abd31bd6df0c6f506","name":"bonsai-2-27b-local","version":"1.0","adapter":"openai_tools","provider":null,"model":"bonsai-2-27b-32k","prompt_version":"1.0","tools_version":"1.0","config":{"model":"bonsai-2-27b-32k","base_url":"http://127.0.0.1:11434/v1","max_tokens":8192,"request_retries":2,"request_timeout_s":900},"sampling":{},"is_simulated":false,"provenance":"live_model","include_hints":false,"capabilities":{"key":"openai_tools","display_name":"OpenAI-compatible tool-calling agent","description":"Host-side agent loop; tools run inside the sandbox. Works with any endpoint exposing /chat/completions with tool calling.","is_simulated":false,"requires_network":true,"requires_credentials":"***REDACTED***","reports_token_usage":"***REDACTED***","re