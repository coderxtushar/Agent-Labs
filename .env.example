# AgentBench Lab configuration.
#
# Copy to `.env` at the repository root and edit. Never commit a filled-in copy.
# Every variable is optional; the defaults below are what the application uses.

# --- core -------------------------------------------------------------------
AGENTBENCH_ENV=local
AGENTBENCH_LOG_LEVEL=INFO
# json for machine-readable logs, console for human-readable
AGENTBENCH_LOG_FORMAT=json

# SQLite is the zero-infrastructure default. For PostgreSQL, install the extra
# (`uv pip install -e '.[postgres]'`) and set a URL like:
#   postgresql+psycopg://agentbench:CHANGE_ME@localhost:5432/agentbench
AGENTBENCH_DATABASE_URL=sqlite:///./data/agentbench.db

AGENTBENCH_DATA_DIR=./data
AGENTBENCH_BENCHMARKS_DIR=./benchmarks

# --- api --------------------------------------------------------------------
AGENTBENCH_API_HOST=127.0.0.1
AGENTBENCH_API_PORT=8000
AGENTBENCH_CORS_ORIGINS=["http://localhost:5173"]

# REQUIRED for any bind that is not loopback. This service starts containers and
# executes untrusted code, so an unauthenticated public bind is a remote code
# execution primitive. `agentbench serve` refuses such a bind without a token.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTBENCH_API_TOKEN=

# Only set this if an authenticating proxy sits in front of the API.
AGENTBENCH_ALLOW_INSECURE_BIND=false

# --- execution --------------------------------------------------------------
# docker | local_unsafe
AGENTBENCH_SANDBOX_PROVIDER=docker

# `local_unsafe` runs task commands directly on the host with NO isolation:
# no filesystem confinement, no network restriction, no resource limits. Enable
# it only for repositories you wrote yourself, or to run the test suite where no
# Docker daemon is available.
AGENTBENCH_ALLOW_LOCAL_UNSAFE_SANDBOX=false

AGENTBENCH_DOCKER_BINARY=docker
AGENTBENCH_DEFAULT_SANDBOX_IMAGE=agentbench/benchmark-python:3.12

# Hard ceilings. A task may request less, never more.
AGENTBENCH_MAX_AGENT_TIMEOUT_S=3600
AGENTBENCH_MAX_SETUP_TIMEOUT_S=1800
AGENTBENCH_MAX_TEST_TIMEOUT_S=1800
AGENTBENCH_MAX_MEMORY_MB=4096
AGENTBENCH_MAX_CPUS=4.0
AGENTBENCH_MAX_CONCURRENT_RUNS=2

# Retries apply to infrastructure failures only. An agent failure is never
# retried automatically, and a retry never deletes the original failure record.
AGENTBENCH_INFRA_RETRY_LIMIT=2

# How long a worker's claim on a run stays valid. A run whose lease expires is
# reclaimable, which is how a crashed worker is recovered.
AGENTBENCH_RUN_LEASE_SECONDS=900

# Set to false when running `agentbench worker` as a separate process.
AGENTBENCH_WORKER_IN_API_PROCESS=true

# --- retention --------------------------------------------------------------
AGENTBENCH_EVENT_PAYLOAD_MAX_CHARS=20000
AGENTBENCH_LOG_TAIL_MAX_CHARS=200000
# 0 disables automatic pruning of old event rows.
AGENTBENCH_EVENT_RETENTION_DAYS=0

# --- model providers --------------------------------------------------------
# Needed only by API-based adapters (openai_tools). Model calls happen on the
# host; the key is never passed into a sandbox. Leave blank to keep those
# adapters disabled - they report "not ready" rather than failing mid-run.
AGENTBENCH_OPENAI_API_KEY=
AGENTBENCH_OPENAI_BASE_URL=https://api.openai.com/v1
AGENTBENCH_ANTHROPIC_API_KEY=
AGENTBENCH_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Optional JSON file overriding the built-in token price table, shaped
# {"model-prefix": [input_usd_per_1m, output_usd_per_1m]}. Costs derived from a
# table are always labelled as estimates.
AGENTBENCH_PRICE_TABLE_PATH=
